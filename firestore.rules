rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth()     { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isMember(hid) {
      return request.auth.uid in
          get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // ── users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isAuth() && isOwner(uid);
    }

    // ── households ───────────────────────────────────────────────────────────
    match /households/{hid} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      // joinCode y members se mutan vía Cloud Function transaccional
      // (createHousehold/joinHousehold), nunca con un update directo del cliente.
      allow create, update: if false;

      match /tasks/{taskId} {
        allow read, write: if isAuth() && isMember(hid);
      }

      match /completions/{cid} {
        allow read, create: if isAuth() && isMember(hid);
        allow update, delete: if false; // historial objetivo, append-only
      }

      match /notes/{noteId} {
        allow read, create: if isAuth() && isMember(hid);
        allow update: if false; // append-only en v1, sin edición
        allow delete: if isAuth() && isOwner(resource.data.authorUid);
      }

      match /messages/{messageId} {
        allow read, create: if isAuth() && isMember(hid);
        // El texto es append-only (nunca se edita), pero las reacciones sí
        // se pueden tocar -- el update solo se permite si el ÚNICO campo
        // que cambia es "reactions", para que nadie pueda reescribir el
        // texto/autor de un mensaje ajeno a través de esta vía.
        allow update: if isAuth() && isMember(hid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if isAuth() && isOwner(resource.data.authorUid);
      }

      match /expenses/{expenseId} {
        allow read, create: if isAuth() && isMember(hid);
        allow update: if false; // sin edición en v1 -- se borra y se rehace
        allow delete: if isAuth() && isOwner(resource.data.paidByUid);
      }

      match /reminders/{reminderId} {
        allow read, create: if isAuth() && isMember(hid);
        allow update: if false;
        allow delete: if isAuth() && isOwner(resource.data.createdBy);
      }

      match /shoppingItems/{itemId} {
        // A diferencia de notas/gastos/recordatorios, aquí SÍ puede borrar
        // cualquier miembro del piso, no solo quien la apuntó -- es una
        // lista de todos, marcar como comprada es tarea de quien fue al
        // súper, no de quien se acordó de apuntarlo.
        allow read, create, delete: if isAuth() && isMember(hid);
        allow update: if false;
      }
    }
  }
}
